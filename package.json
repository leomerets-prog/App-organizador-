{
  "name": "organizador",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "build:tablet": "tsc -b && vite build --outDir tablet --emptyOutDir",
    "preview": "vite preview --host",
    "typecheck": "tsc -b --noEmit",
    "test:scribble": "esbuild tools/scribble-test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/scribble-test.mjs --log-level=error && node node_modules/.cache/scribble-test.mjs",
    "test:erase": "esbuild tools/erase-test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/erase-test.mjs --log-level=error && node node_modules/.cache/erase-test.mjs",
    "test": "npm run check:java && npm run test:reamostra && npm run test:scribble && npm run test:erase && npm run test:fields && npm run test:zones && npm run test:central && npm run test:audio && npm run test:flow && npm run test:history",
    "test:fields": "esbuild tools/fields-test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/fields-test.mjs --log-level=error && node node_modules/.cache/fields-test.mjs",
    "test:zones": "esbuild tools/zones-test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/zones-test.mjs --log-level=error && node node_modules/.cache/zones-test.mjs",
    "test:history": "esbuild tools/history-test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/history-test.mjs --log-level=error && node node_modules/.cache/history-test.mjs",
    "test:flow": "esbuild tools/flow-test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/flow-test.mjs --log-level=error && node node_modules/.cache/flow-test.mjs",
    "test:audio": "esbuild tools/audio-test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/audio-test.mjs --log-level=error && node node_modules/.cache/audio-test.mjs",
    "test:central": "esbuild tools/central-test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/central-test.mjs --log-level=error && node node_modules/.cache/central-test.mjs",
    "check:java": "bash tools/check-java.sh",
    "test:reamostra": "bash tools/resample-test.sh"
  },
  "dependencies": {
    "@capacitor/core": "^6.2.1",
    "idb": "^8.0.0",
    "perfect-freehand": "^1.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/cli": "^6.2.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^0.20.5"
  }
}
